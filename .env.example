# =============================================================================
# gold-desire 部署配置模板（Docker Compose 用，位于仓库根 gold-desire/.env）
#
# 首次部署：cp .env.example .env && 修改标注【必改】的项，然后 scripts/deploy.sh
# 本文件会被：
#   1. compose 读取做 ${VAR} 插值（POSTGRES_* / NGINX_* / TIMEZONE / SERVER_*）
#   2. 经 env_file 整体注入 api / worker / migrate 容器（pydantic Settings 读取）
# 字段口径与 backend/.env.example 一致，仅默认值面向容器网络（postgres/redis 主机名）。
# =============================================================================

# ============================== 基础设施（compose 插值） ==============================
# PostgreSQL 16（容器名 gold-desire-postgres，数据卷 pg_data）
POSTGRES_USER=gold
# 【必改】数据库口令（同时出现在 DATABASE_URL 中，两处保持一致）
POSTGRES_PASSWORD=gold-desire-change-me
POSTGRES_DB=gold_desire

# nginx 对外端口（80/443 与宿主机冲突时改这里）
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# 业务统一时区
TIMEZONE=Asia/Shanghai

# 备份保留份数（scripts/backup.sh 滚动清理）
BACKUP_KEEP=14

# ================================== 应用 ==================================
APP_ENV=prod
APP_NAME=gold-desire
APP_DEBUG=false
APP_VERSION=0.1.0

# 服务（SERVER_PORT/WORKERS 供 compose 启动命令与健康检查使用）
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1

# ------------------------------- 数据库（容器内） -------------------------------
# 主机名固定为 postgres（compose 服务名）；口令与 POSTGRES_PASSWORD 保持一致
DATABASE_URL=postgresql+asyncpg://gold:gold-desire-change-me@postgres:5432/gold_desire
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ------------------------------------ 缓存 ------------------------------------
# 生产一律 redis（跨进程共享 + 限流 + HITL 令牌都依赖）
CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL=60
CACHE_MAX_ENTRIES=10000

# ---------------------------------- 分页/批写 ----------------------------------
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=200
UPSERT_CHUNK_SIZE=500

# ------------------------------ 认证（【必改】密钥） ------------------------------
# 【必改】JWT 签名密钥：openssl rand -hex 32 生成，泄露 = 全部 token 可伪造
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Argon2 时间成本参数（3 为服务端常驻的均衡值；调大更安全也更慢）
PASSWORD_HASH_ROUNDS=3

# --------------------- Agent（OpenAI 兼容接口，【必改】密钥） ---------------------
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
# 【必改】模型 API Key（DeepSeek/Qwen/本地 vLLM 等兼容接口均可）
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=gpt-4o-mini
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_TURNS=12
AGENT_MAX_TOOL_CALLS=30

# --------------------- 上游数据源（【必改】填真实密钥后重启生效） ---------------------
# 注意：密钥只影响采集侧（worker）；服务侧读接口不触达上游
HITHINK_API_KEY=
HITHINK_BASE_URL=https://fuyao.aicubes.cn
XUANGUTONG_API_KEY=
XUANGUTONG_BASE_URL=https://api.xuangutong.example
EASTMONEY_API_KEY=
EASTMONEY_BASE_URL=https://api.eastmoney.example

# ------------------------------------- CORS -------------------------------------
# 同域部署（nginx 同源反代）时保持默认即可；跨域访问才需要追加来源
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------- 限流 -------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=5

# --------------------------- 采集调度（可选，默认注释） ---------------------------
#INGEST_WINDOW_AUCTION=09:25-09:40
#INGEST_WINDOW_INTRADAY=09:26-10:00
#INGEST_WINDOW_TAILPAN=14:45-15:00
#INGEST_WINDOW_POSTMARKET=17:00-18:00
#INGEST_TICK_SECONDS=15
#INGEST_CALENDAR_TTL_SECONDS=432000

# --------------------------- 读路径新鲜度（可选） ---------------------------
# 期望新鲜度窗口（分钟，默认 720 = 12h）；超窗即接口返回 stale=true
#GD_MARKET_FRESHNESS_MINUTES=720
