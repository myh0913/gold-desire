# ===== 应用 =====
APP_ENV=dev
APP_NAME=gold-desire
APP_DEBUG=false
APP_VERSION=0.1.0

# ===== 服务 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8100
SERVER_WORKERS=1
# 业务统一时区（前端/后端保持一致）
TIMEZONE=Asia/Shanghai

# ===== 数据库 =====
# 本地默认 SQLite（无需装 PG 即可启动）；生产改为 postgresql+asyncpg://user:pass@host:5432/gold_desire
DATABASE_URL=sqlite+aiosqlite:///./gold_desire.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ===== 分页/批写 =====
# 列表接口默认/最大页大小（禁止无界返回）；批量 upsert 每批行数
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=200
UPSERT_CHUNK_SIZE=500

# ===== 缓存 =====
# 可选 memory（默认，无需 Redis）/ redis
CACHE_BACKEND=memory
REDIS_URL=
CACHE_DEFAULT_TTL=60
CACHE_MAX_ENTRIES=10000

# ===== 认证（生产务必替换）=====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Argon2 时间成本参数
PASSWORD_HASH_ROUNDS=3

# ===== Agent（OpenAI 兼容接口）=====
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=gpt-4o-mini
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_TURNS=12
AGENT_MAX_TOOL_CALLS=30

# ===== 上游数据源（生产填入真实密钥）=====
HITHINK_API_KEY=
HITHINK_BASE_URL=https://api.hithink.example
XUANGUTONG_API_KEY=
XUANGUTONG_BASE_URL=https://api.xuangutong.example
EASTMONEY_API_KEY=
EASTMONEY_BASE_URL=https://api.eastmoney.example
# 真实源全部失败时是否允许降级到 fake 源（返回固定假数据）
# 仅本地开发/测试可用；APP_ENV=prod 时强制关闭，真实源全挂会显式报错而非写假数据
ALLOW_FAKE_FALLBACK=true

# ===== CORS =====
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273
CORS_ALLOW_CREDENTIALS=true

# ===== 限流 =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=5

# ===== 采集调度（由 app/ingest/windows.py 直接读环境变量，非 Settings 字段）=====
# 窗口形如 "09:25-09:40"；只覆盖需要改的窗口，其余用默认
#INGEST_WINDOW_AUCTION=09:25-09:40
#INGEST_WINDOW_INTRADAY=09:26-10:00
#INGEST_WINDOW_TAILPAN=14:45-15:00
#INGEST_WINDOW_POSTMARKET=17:00-18:00
# 常驻调度器 tick 间隔（秒，默认 15）
#INGEST_TICK_SECONDS=15
# 交易日历缓存 TTL（秒，默认 5 天）
#INGEST_CALENDAR_TTL_SECONDS=432000

# ===== 读路径新鲜度（app/services/freshness.py 直接读环境变量）=====
# 期望新鲜度窗口（分钟，默认 720 = 12h）；超窗即接口返回 stale=true
#GD_MARKET_FRESHNESS_MINUTES=720